# Production settings for infra/gcp/deploy-prod.sh. Copy to .env.production in the repo root
# (git-ignored) and fill in. Real PHI: keep the file on the owner's Mac only (chmod 600).
# deploy-prod.sh refuses anything synthetic-only; see docs/solution/G4_PHI_GATE.md.

CAREPLIX_ENV=production

# LiveKit: a production project of its own (never the labs project).
LIVEKIT_URL=wss://<production-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# NexHealth production key and the pilot practice.
NEXHEALTH_ENV=production
NEXHEALTH_API_KEY=
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_INSTITUTION_ID=
NEXHEALTH_LOCATION_ID=

# Clearinghouse production key (stored as cpx-stedi-prod-api-key). No test keys here.
STEDI_ENV=production
STEDI_PROD_API_KEY=
PRACTICE_NPI=

# Optional: Claude on the Anthropic API (judge, browser agent); email codes and invitations.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Customer sign-in. STUDIO_PUBLIC=true lets clinic staff sign in (needs a method below);
# otherwise the Studio stays behind IAP for IAP_MEMBERS (default domain:careplix.com).
STUDIO_PUBLIC=false
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
IAP_MEMBERS=domain:careplix.com

# Must stay empty in production (synthetic-only or labs-only):
# STEDI_TEST_API_KEY STEDI_API_KEY OPENEMR_BASE_URL SANDBOX_NUMBER SANDBOX_OUTBOUND_TRUNK_ID
# PAYER_SANDBOX_URL PLATFORM_ADMINS
