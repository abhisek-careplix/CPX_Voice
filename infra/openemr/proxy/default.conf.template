# Rendered by the nginx image at start (envsubst): OPENEMR_UPSTREAM is the VM's private address.
server {
    listen ${PORT};
    client_max_body_size 50m;

    location / {
        proxy_pass http://${OPENEMR_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # IAP's identity headers stay at the edge; OpenEMR has its own login.
        proxy_set_header X-Goog-IAP-JWT-Assertion "";
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}
