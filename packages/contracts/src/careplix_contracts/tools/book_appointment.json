{
  "name": "book_appointment",
  "version": "1.0.0",
  "description": "Book one of the times returned by find_slots for the verified patient. Read the time back and get a clear yes before calling. The practice's EHR is updated through CarePlix; report the result exactly as returned.",
  "classification": "write",
  "execution": "api",
  "allowed_roles": [
    "agent_runtime"
  ],
  "timeout_ms": 20000,
  "idempotency": "keyed",
  "limits": {
    "max_writes_per_call": 3
  },
  "arguments_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "slot_id"
    ],
    "properties": {
      "slot_id": {
        "type": "string",
        "pattern": "^S[0-9]{1,3}$",
        "description": "A slot_id returned by find_slots on this call."
      }
    }
  },
  "result_schema": {
    "type": "object",
    "required": [
      "state"
    ],
    "properties": {
      "state": {
        "enum": [
          "booked",
          "rescheduled",
          "cancelled",
          "requested",
          "pending",
          "slot_taken",
          "failed",
          "needs_staff",
          "front_desk"
        ]
      },
      "when": {
        "type": "string"
      },
      "message": {
        "type": "string"
      }
    }
  },
  "owner": "front-office",
  "release": "D",
  "enabled_in_demo": true
}
