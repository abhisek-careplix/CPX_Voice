# CarePlix Voice — local configuration template.
# Copy to .env and fill in. Never commit .env. Synthetic data only until the G4 PHI gate.

CAREPLIX_ENV=dev

# --- API ---------------------------------------------------------------------
# Local development uses SQLite. Shared environments use Postgres, e.g.
# postgresql+asyncpg://careplix:careplix@localhost:5432/careplix
DATABASE_URL=sqlite+aiosqlite:///./careplix-dev.db
# Signs Studio sessions and attempt-scoped worker tokens. Required outside dev.
SESSION_SECRET=
# Shared secret the agent worker exchanges for an attempt token. Must match on API and worker.
# Dev falls back to a built-in value when empty; set a strong value anywhere else.
WORKER_SERVICE_TOKEN=
# Comma-separated E.164 numbers outbound tasks may call in release D (FR05, SEC12).
APPROVED_TEST_DESTINATIONS=

# --- Worker ------------------------------------------------------------------
# Where the worker reaches the CarePlix API. A hosted LiveKit worker needs a public URL.
CAREPLIX_API_URL=http://localhost:8080

# --- LiveKit (OD03) ----------------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Agent name used for explicit dispatch (doc 02: no automatic dispatch).
LIVEKIT_AGENT_NAME=careplix-agent
# Outbound SIP trunk ID created in LiveKit for the selected carrier (OD01). Empty until qualified.
LIVEKIT_OUTBOUND_TRUNK_ID=

# --- NexHealth (EHR/PM read and write) ---------------------------------------
# Set with ./scripts/connect-nexhealth.sh (prompts for the key, never echoes it).
NEXHEALTH_API_KEY=
NEXHEALTH_ENV=sandbox
NEXHEALTH_SUBDOMAIN=
NEXHEALTH_INSTITUTION_ID=
NEXHEALTH_LOCATION_ID=

# --- OpenEMR (local EHR for end-to-end testing) ------------------------------
# make openemr-up && make openemr-setup fills these in (synthetic clinic, local only).
OPENEMR_BASE_URL=
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
OPENEMR_USERNAME=
OPENEMR_PASSWORD=
OPENEMR_TIMEZONE=America/New_York
OPENEMR_VERIFY_TLS=true
OPENEMR_FACILITY_ID=
OPENEMR_UI_URL=

# --- Stedi (clearinghouse: eligibility, claims, status, ERAs) -----------------
# Set with ./scripts/connect-stedi.sh (prompts for the key, never echoes it).
STEDI_API_KEY=
STEDI_ENV=test
# Standard Webhooks secret from the Stedi event destination (optional).
STEDI_WEBHOOK_SECRET=
# Practice identity sent on eligibility checks (production). Test mode uses Stedi's mock NPI.
PRACTICE_NPI=
PRACTICE_NAME=CarePlix Practice
# Fernet key that encrypts patient identifiers in the practice mirror. Dev derives one.
DATA_ENCRYPTION_KEY=
# Public URL of the webhook ingress (careplix-webhooks). Empty keeps webhooks off.
WEBHOOK_PUBLIC_URL=

# --- Google / Vertex AI (OD04) -----------------------------------------------
GCP_PROJECT=
VERTEX_LOCATION=us-central1
# Fallbacks only: the Studio's Connections page sets project, region and approved model per workspace.
GEMINI_LIVE_MODEL=
GEMINI_VOICE=Puck
# Worker credential fallback (BUILD_PLAN R2): JSON of a restricted service account
# (roles/aiplatform.user only), stored as a LiveKit Cloud agent secret. Leave empty to use ADC.
GOOGLE_SERVICE_ACCOUNT_JSON=
